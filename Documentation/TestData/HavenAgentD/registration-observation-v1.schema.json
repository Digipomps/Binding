{
  "$id": "https://schemas.haven.digipomps.org/agentd/registration-observation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Redacted, owner-reported HavenAgentD runtime observation. This is evidence, not an authorization grant.",
  "properties": {
    "availableActionIDs": {
      "items": {
        "enum": [
          "mac.finder.close-all-windows",
          "shortcut.binding.wake",
          "binding.absorb.cell-input",
          "folder-watch.changed-input",
          "sprout.sync.local-agent"
        ],
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "bridgeEndpoint": {
      "description": "Optional loopback-only ws/wss endpoint without credentials, query, or fragment.",
      "format": "uri",
      "type": "string"
    },
    "containsAccessToken": {
      "const": false
    },
    "evidenceAuthority": {
      "const": "owner-reported-runtime-observation-not-a-grant"
    },
    "evidenceKind": {
      "const": "haven-agentd.status-json"
    },
    "observedAt": {
      "format": "date-time",
      "type": "string"
    },
    "schema": {
      "const": "haven.agentd-registration-observation.v1"
    },
    "status": {
      "enum": [
        "installed_not_running",
        "registered"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "status",
    "evidenceKind",
    "availableActionIDs",
    "observedAt",
    "evidenceAuthority",
    "containsAccessToken"
  ],
  "title": "HAVEN AgentD registration observation v1",
  "type": "object"
}
