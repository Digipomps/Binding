<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(HAVEN_DISPLAY_NAME)</string>
	<key>CFBundleName</key>
	<string>HAVEN</string>
	<key>HAVENDeviceIngressPublicOrigin</key>
	<string>$(HAVEN_DEVICE_INGRESS_PUBLIC_ORIGIN)</string>
	<key>HAVENDeviceIngressAudience</key>
	<string>$(HAVEN_DEVICE_INGRESS_AUDIENCE)</string>
	<key>HAVENDeviceIngressChallengeIssuerBase64</key>
	<string>$(HAVEN_DEVICE_INGRESS_CHALLENGE_ISSUER_BASE64)</string>
	<key>HAVENDeviceIngressRolloutEnvironment</key>
	<string>$(HAVEN_DEVICE_INGRESS_ROLLOUT_ENVIRONMENT)</string>
	<key>NSCameraUsageDescription</key>
	<string>HAVEN bruker kameraet til å skanne koden som kobler denne telefonen til entiteten din.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>app.binding.haven-links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>haven</string>
			</array>
		</dict>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_haven-link._tcp</string>
		<string>_haven-radar._tcp</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>HAVEN bruker Bluetooth bare når du starter Nearby Scanner, for å oppdage nærliggende HAVEN-enheter og etablere kontakt med eksplisitt samtykke.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>HAVEN bruker lokalnettet når du velger å finne eller vise en invitasjon til entiteten din i nærheten, eller starter Nearby Scanner.</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>HAVEN bruker Nearby Interaction bare når du starter Nearby Scanner, for å vise ærlig avstand og retning til enheter du velger å oppdage.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Cell Configuration</string>
			<key>UTTypeIdentifier</key>
			<string>app.binding.cellconfiguration</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cellconfig</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-cellconfiguration</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>HAVEN Component Palette Item</string>
			<key>UTTypeIdentifier</key>
			<string>app.binding.componentpaletteitem</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.mime-type</key>
				<string>application/x-binding-componentpaletteitem</string>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Cell Configuration</string>
			<key>UTTypeIdentifier</key>
			<string>app.binding.cellconfiguration</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cellconfig</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-cellconfiguration</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
