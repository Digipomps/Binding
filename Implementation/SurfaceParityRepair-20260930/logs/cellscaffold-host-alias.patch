+  const references = configurationReferences();
+  const firstLabeled = references.find(hasConfigurationReferenceLabel);
+  const rootLabel = firstLabeled?.label || "conferenceUIRouter";
+  const view = { state: conferenceMVPState.viewState || {} };
+  const roots = [[rootLabel, view]];
+
+  // This HTTP host has fetched one Cell's state. Another label for that exact
+  // endpoint is an alias; a reference to any other endpoint needs its own data.
+  if (typeof firstLabeled?.endpoint === "string" && firstLabeled.endpoint.length > 0) {
+    for (const reference of references) {
+      if (hasConfigurationReferenceLabel(reference)
+          && reference.label !== rootLabel
+          && reference.endpoint === firstLabeled.endpoint) {
+        roots.push([reference.label, view]);
+      }
+    }
+  }
+  return Object.fromEntries(roots);
 }
 
