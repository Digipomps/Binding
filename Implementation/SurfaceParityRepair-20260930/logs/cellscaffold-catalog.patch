+    func testPublicCatalogPolicyAllowsOnlyExactStaticReadPaths() async throws {
+        CellBase.debugValidateAccessForEverything = false
+        let owner = try await testIdentity("public-catalog-owner", displayName: "Owner")
+        let outsider = try await testIdentity("public-catalog-outsider", displayName: "Outsider")
+        let cell = await PersonalCopilotPublicConfigurationCell(owner: owner)
