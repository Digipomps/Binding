+    func testAnonymousCatalogGETsStayPublicWhenCentralIdentityCreationIsUnavailable() async throws {
+        let app = try await Application.make(.testing)
+        do {
+            try await configure(app)
+            let configuredVault = CellBase.defaultIdentityVault
+            let configuredResolver = CellBase.defaultCellResolver
+            let configuredDebugAccess = CellBase.debugValidateAccessForEverything
+            defer {
+                CellBase.defaultIdentityVault = configuredVault
+                CellBase.defaultCellResolver = configuredResolver
+                CellBase.debugValidateAccessForEverything = configuredDebugAccess
+            }
+            let centralVault = RecordingIdentityVault(allowCreation: false)
+            CellBase.defaultIdentityVault = centralVault
+            CellBase.debugValidateAccessForEverything = false
+            let resolver = try XCTUnwrap(configuredResolver)
+            let before = await resolver.resolverRegistrySnapshot(requester: Identity())
+            let beforeIdentityInstances = try canonicalBytes(before.identityNamedInstances)
+            let routes = [
+                "/personal-copilot-v1/api/catalog",
+                "/personal-copilot-v1/api/catalog/allowed",
+                "/personal-copilot-v1/api/catalog/unavailable",
+                "/personal-copilot-v1/api/catalog/policy-summary"
+            ]
+            for route in routes {
+                var baseline = Data()
+                try await app.test(.GET, route) { response async throws in
+                    XCTAssertEqual(response.status, .ok, route)
+                    let value = try response.content.decode(ValueType.self)
+                    baseline = try publicCatalogBytes(value)
+                    if route.hasSuffix("/allowed") {
+                        XCTAssertEqual(asList(value)?.count, PersonalCopilotConfigurationFactory.catalogEntryObjects().count)
+                    } else if route.hasSuffix("/unavailable") {
+                        XCTAssertEqual(asList(value)?.count, 0)
+                    } else if route.hasSuffix("/policy-summary") {
+                        let policy = try XCTUnwrap(asObject(value))
+                        XCTAssertEqual(asBool(policy["conferenceExposed"]), false)
+                        XCTAssertEqual(asList(policy["remoteNativePermissionRequests"])?.count, 0)
+                    } else {
+                        XCTAssertEqual(Set(try XCTUnwrap(asObject(value)).keys),
+                                       Set(["state", "entries", "configurations", "policySummary"]))
+                    }
+                    XCTAssertNil(response.headers.first(name: .setCookie),
+                                 "Static catalog reads must not allocate a requester session.")
+                }
+                try await app.test(
+                    .GET, route + "?persona=forged-owner&user=other-owner",
+                    beforeRequest: { req async in
+                        req.headers.replaceOrAdd(name: "X-Personal-Copilot-User", value: "forged-header-owner")
+                    },
+                    afterResponse: { response async throws in
+                        XCTAssertEqual(response.status, .ok, route)
+                        XCTAssertEqual(try publicCatalogBytes(response.content.decode(ValueType.self)), baseline,
+                                       "Untrusted persona hints must not select private catalog data.")
+                    }
+                )
+            }
+            let after = await resolver.resolverRegistrySnapshot(requester: Identity())
+            XCTAssertEqual(try canonicalBytes(after.identityNamedInstances), beforeIdentityInstances)
+            let mutations = await centralVault.mutationOperations()
+            XCTAssertEqual(mutations, [], "Catalog discovery must never create central identity bindings.")
+
+            // No central vault is needed for the static public read model at all.
+            CellBase.defaultIdentityVault = nil
+            try await app.test(.GET, routes[0]) { response async throws in
+                XCTAssertEqual(response.status, .ok)
+                let catalog = try response.content.decode(ValueType.self)
+                let object = try XCTUnwrap(asObject(catalog))
+                XCTAssertEqual(asList(object["entries"])?.count, PersonalCopilotConfigurationFactory.catalogEntryObjects().count)
+                // ValueType emits configurations as plain JSON objects on HTTP.
+                let configurations = try XCTUnwrap(asList(object["configurations"]))
+                let decoded = try configurations.map {
+                    try JSONDecoder().decode(CellConfiguration.self, from: JSONEncoder().encode($0))
+                }
+                XCTAssertEqual(Set(decoded.map(\.name)),
+                               Set(PersonalCopilotConfigurationFactory.catalogConfigurations().map(\.name)))
+            }
+            // Still require Resolver admission; no direct HTTP factory fallback.
+            CellBase.defaultCellResolver = nil
+            try await app.test(.GET, routes[0]) { response async in
+                XCTAssertEqual(response.status, .internalServerError)
+            }
+            CellBase.defaultCellResolver = configuredResolver
+            try await app.asyncShutdown()
+        } catch {
+            try? await app.asyncShutdown()
+            throw error
+        }
+    }
