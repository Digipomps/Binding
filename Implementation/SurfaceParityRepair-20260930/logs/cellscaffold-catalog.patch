+        let privateCatalog = await PersonalCopilotConfigurationCatalogCell(owner: owner)
+        let publicState = try XCTUnwrap(catalog["state"])
+        let ownerState = try await privateCatalog.get(keypath: PersonalCopilotAppStoreV1Contract.catalogStateKeypath, requester: owner)
+        XCTAssertEqual(try canonicalBytes(publicState), try canonicalBytes(ownerState))
