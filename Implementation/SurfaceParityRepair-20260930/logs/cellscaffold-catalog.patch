+    private func publicCatalogBytes(_ value: ValueType) throws -> Data {
+        // Configuration/skeleton constructors allocate transient Swift UUIDs.
+        // Ignore only UUID-shaped id/uuid fields; compare every other field.
+        func normalize(_ value: Any) -> Any {
+            if let object = value as? [String: Any] {
+                return object.mapValues { normalize($0) }.filter { key, value in
+                    guard key == "uuid" || key == "id", let string = value as? String else { return true }
+                    return UUID(uuidString: string) == nil
+                }
+            }
+            if let list = value as? [Any] { return list.map(normalize) }
+            return value
+        }
+        let object = try JSONSerialization.jsonObject(with: JSONEncoder().encode(value), options: [.fragmentsAllowed])
+        return try JSONSerialization.data(withJSONObject: normalize(object), options: [.sortedKeys, .fragmentsAllowed])
+    }
+
     private func canonicalBytes<T: Encodable>(_ value: T) throws -> Data {
         let encoder = JSONEncoder()
         encoder.outputFormatting = [.sortedKeys]
