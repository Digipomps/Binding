diff --git a/Binding/OwnerAttachRuntimeFixture.swift b/Binding/OwnerAttachRuntimeFixture.swift
new file mode 100644
index 00000000..f6707d29
--- /dev/null
+++ b/Binding/OwnerAttachRuntimeFixture.swift
@@ -0,0 +1,91 @@
+import SwiftUI
+import CellBase
+
+nonisolated enum OwnerAttachRuntimeFixture {
+    static var enabled: Bool {
+        #if DEBUG && os(macOS)
+        ProcessInfo.processInfo.arguments.contains("--owner-attach-runtime-test")
+        #else
+        false
+        #endif
+    }
+}
+
+#if DEBUG && os(macOS)
+private actor OwnerAttachFixtureStore: OwnerAttachExtensionStore {
+    private var entries: [String: Data] = [:]
+    private(set) var writes = 0
+    func read(id: String) -> Data? { entries[id] }
+    func write(_ data: Data, id: String) { entries[id] = data; writes += 1 }
+}
+
+/// Executable acceptance fixture using real Cells, crypto, consent and policy.
+/// Its vault and stores live only in this process; it never boots user state.
+struct OwnerAttachRuntimeFixtureView: View {
+    @ObservedObject private var controller = BindingOwnerAttachExtension.shared
+    @State private var owner: Identity?
+    @State private var source: GeneralCell?
+    @State private var cell: GeneralCell?
+    @State private var client: OwnerAttachEntityExtensionClient?
+    @State private var hostStore = OwnerAttachFixtureStore()
+    @State private var result = "Forbereder isolert runtime"
+    @State private var completed = 0
+    var body: some View {
+        VStack(spacing: 18) {
+            Text("Entitetsutvidelse — isolert runtime-test").font(.title2)
+            Text(result).accessibilityIdentifier("ownerAttach.result")
+            Text("Fullføringer: \(completed)")
+            Button("Attach eid celle igjen") { Task { await attach() } }
+                .accessibilityIdentifier("ownerAttach.attach")
+        }
+        .frame(width: 600, height: 760)
+        .sheet(item: Binding(get: { controller.review }, set: { if $0 == nil { controller.resolve(nil) } })) { review in
+            BindingOwnerAttachReviewView(review: review)
+        }
+        .task {
+            guard owner == nil else { return }
+            let vault = EphemeralIdentityVault()
+            guard let human = await vault.identity(for: "private", makeNewIfNotFound: true),
+                  let receiver = await vault.identity(for: "test-runtime", makeNewIfNotFound: true) else { return }
+            owner = human
+            source = await GeneralCell(owner: human)
+            cell = await GeneralCell(owner: human.publicIdentitySnapshot())
+            client = OwnerAttachEntityExtensionClient(store: OwnerAttachFixtureStore())
+            await OwnerAttachExtensionRuntime.shared.install(OwnerAttachEntityExtensionHost(
+                receiver: receiver, label: "Teststed på denne Macen", store: hostStore))
+            await attach()
+        }
+    }
+
+    private func attach() async {
+        guard let owner, let source, let cell, let client else { return }
+        do {
+            let store = hostStore
+            _ = try await OwnerAttachExtensionContext.$handler.withValue({ source, emitter, label, requester in
+                do {
+                    let outcome = try await client.consider(emitter: emitter, activeHuman: owner, requester: requester,
+                        stillAttached: { await source.getEmitterWithLabel(label, requester: requester) === emitter },
+                        review: { offer in await controller.ask(offer, endpoint: "Lokal testcelle · ingen nettverkstrafikk") })
+                    let writes = await store.writes
+                    await record(outcome, writes: writes)
+                } catch {
+                    await report(error)
+                }
+            }) {
+                try await source.attach(emitter: cell, label: "owned", requester: owner)
+            }
+        } catch { result = "Runtime-test feilet: \(error)" }
+    }
+    private func record(_ outcome: OwnerAttachExtensionOutcome, writes: Int) {
+        switch outcome {
+        case .confirmed:
+            completed += 1
+            result = "Bekreftet. Lagrede tilstedeværelser: \(writes)"
+        case .declined: result = "Avslått. Cellen er fortsatt tilkoblet."
+        default: result = "Venter på ny attach."
+        }
+    }
+    private func report(_ error: Error) { result = "Runtime-test feilet: \(error)" }
+
+}
+#endif
