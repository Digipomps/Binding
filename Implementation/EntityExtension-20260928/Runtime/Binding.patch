diff --git a/Binding/BindingOwnerAttachExtension.swift b/Binding/BindingOwnerAttachExtension.swift
new file mode 100644
index 00000000..d602ea1c
--- /dev/null
+++ b/Binding/BindingOwnerAttachExtension.swift
@@ -0,0 +1,238 @@
+import Foundation
+import SwiftUI
+import Combine
+import CellBase
+
+@MainActor
+final class BindingOwnerAttachExtension: ObservableObject {
+    static let shared = BindingOwnerAttachExtension()
+    struct Review: Identifiable {
+        let id = UUID()
+        let offer: OwnerAttachExtensionOffer
+        let endpoint: String
+    }
+    struct PolicyRow: Identifiable {
+        var id: String { binding.storageID }
+        let binding: OwnerAttachExtensionBinding
+        let label: String
+        let policy: OwnerAttachExtensionPolicy
+    }
+    @Published private(set) var policies: [PolicyRow] = []
+    @Published private(set) var policyLoadError: String?
+    private var policyStore: OwnerAttachEncryptedStore?
+    @Published private(set) var review: Review?
+    @Published private(set) var status: String?
+    @Published private(set) var latestBinding: OwnerAttachExtensionBinding?
+    private var answer: CheckedContinuation<OwnerAttachExtensionChoice?, Never>?
+    private var reviewExpiry: Task<Void, Never>?
+    private var jobs: [UUID: Task<Void, Never>] = [:]
+    private var reviewedInteractions: [UUID: Set<String>] = [:]
+    private var client: OwnerAttachEntityExtensionClient?
+    private var configuredVault: String?
+    private var preparationTask: Task<Void, Error>?
+
+    func prepare() async throws {
+        if let preparationTask { return try await preparationTask.value }
+        let task = Task { @MainActor in try await self.performPreparation() }
+        preparationTask = task
+        defer { preparationTask = nil }
+        try await task.value
+    }
+
+    private func performPreparation() async throws {
+        guard let vault = CellBase.defaultIdentityVault,
+              let secrets = vault as? any ScopedSecretProviderProtocol,
+              let vaultID = await vault.identityVaultReference(),
+              let root = CellBase.documentRootPath else { throw OwnerAttachExtensionError.unavailable }
+        guard configuredVault != vaultID else { return }
+        resolve(nil)
+        if configuredVault != nil { jobs.values.forEach { $0.cancel() }; jobs.removeAll() }
+        client = nil; configuredVault = nil
+        let directory = URL(fileURLWithPath: root).appendingPathComponent("OwnerAttach", isDirectory: true)
+            .appendingPathComponent(OwnerAttachWire.digest(Data(vaultID.utf8)), isDirectory: true)
+        let key = try await secrets.scopedSecretData(tag: "binding.owner-attach-client.v1", minimumLength: 32)
+        let store = try OwnerAttachEncryptedStore(directory: directory.appendingPathComponent("Decisions"), key: key)
+        client = OwnerAttachEntityExtensionClient(store: store)
+        policyStore = store
+        try await OwnerAttachExtensionRuntime.shared.configure(vault: vault,
+            directory: directory.appendingPathComponent("Receipts"), label: "HAVEN-appen")
+        configuredVault = vaultID
+    }
+
+    /// Only called inside a context installed by an explicit navigation gesture.
+    /// Queueing keeps a consent sheet from holding up normal cell attachment.
+    func attached(source: GeneralCell, emitter: any Emit, label: String, requester: Identity, endpoint: String, interactionID: UUID) {
+        guard emitter is BridgeBase, jobs.count < 8 else { return }
+        let id = UUID()
+        jobs[id] = Task { [weak self, weak source] in
+            guard let self, let source else { return }
+            defer { self.jobs[id] = nil }
+            do {
+                try await self.prepare()
+                guard let client = self.client,
+                      let human = await CellBase.defaultIdentityVault?.identity(for: "private", makeNewIfNotFound: false),
+                      human.referencesSameSigningIdentity(as: requester) else { return }
+                let outcome = try await client.consider(emitter: emitter, activeHuman: human, requester: requester, receiverEndpoint: endpoint,
+                    stillAttached: { [weak source] in
+                        guard let source,
+                              let active = await CellBase.defaultIdentityVault?.identity(for: "private", makeNewIfNotFound: false),
+                              active.referencesSameSigningIdentity(as: human),
+                              let current = await source.getEmitterWithLabel(label, requester: requester) else { return false }
+                        return current === emitter
+                    }, review: { [weak self] offer in
+                        await self?.askOnce(offer, endpoint: endpoint, interactionID: interactionID)
+                    })
+                if case let .confirmed(receipt) = outcome {
+                    self.latestBinding = receipt.binding
+                    self.status = "Entitetens tilstedeværelse er registrert her med identiteten du allerede bruker."
+                } else if case let .declined(binding) = outcome {
+                    self.latestBinding = binding
+                }
+            } catch {
+                // Unsupported peers and ordinary shared-cell access are normal.
+                // A failed completion must remain visibly unconfirmed.
+                if let failure = error as? OwnerAttachExtensionError,
+                   failure != .unavailable, failure != .ownerProofRequired, failure != .enrollmentRequired {
+                    self.status = "Entitetsutvidelsen kunne ikke bekreftes. Åpne cellen igjen for å prøve på nytt."
+                }
+            }
+        }
+    }
+
+    func cancelPending() {
+        resolve(nil)
+        jobs.values.forEach { $0.cancel() }
+        jobs.removeAll()
+        reviewedInteractions.removeAll()
+    }
+
+    private func askOnce(_ offer: OwnerAttachExtensionOffer, endpoint: String, interactionID: UUID) async -> OwnerAttachExtensionChoice? {
+        guard reviewedInteractions[interactionID, default: []].insert(offer.binding.storageID).inserted else { return nil }
+        return await ask(offer, endpoint: endpoint)
+    }
+
+    func ask(_ offer: OwnerAttachExtensionOffer, endpoint: String) async -> OwnerAttachExtensionChoice? {
+        guard review == nil, !Task.isCancelled else { return nil }
+        latestBinding = offer.binding
+        let pending = Review(offer: offer, endpoint: endpoint)
+        return await withTaskCancellationHandler {
+            await withCheckedContinuation { continuation in
+                answer = continuation
+                review = pending
+                reviewExpiry = Task { [weak self] in
+                    let remaining = max(0, min(295, offer.expiresAt.timeIntervalSinceNow))
+                    try? await Task.sleep(nanoseconds: UInt64(remaining * 1_000_000_000))
+                    guard !Task.isCancelled else { return }
+                    self?.resolve(nil, reviewID: pending.id)
+                }
+            }
+        } onCancel: {
+            Task { @MainActor [weak self] in self?.resolve(nil, reviewID: pending.id) }
+        }
+    }
+
+    func resolve(_ choice: OwnerAttachExtensionChoice?, reviewID: UUID? = nil) {
+        if let reviewID, review?.id != reviewID { return }
+        let continuation = answer; answer = nil
+        reviewExpiry?.cancel(); reviewExpiry = nil
+        review = nil
+        continuation?.resume(returning: choice)
+    }
+
+    func forgetLatestPolicy() async {
+        guard let latestBinding, let client else { return }
+        do {
+            try await client.forgetPolicy(for: latestBinding)
+            status = "HAVEN spør igjen neste gang du åpner en eid celle her."
+        } catch { status = "Innstillingen kunne ikke lagres. Prøv igjen." }
+    }
+
+    func refreshPolicies() async {
+        do {
+            try await prepare()
+            guard let store = policyStore,
+                  let human = await CellBase.defaultIdentityVault?.identity(for: "private", makeNewIfNotFound: false) else {
+                throw OwnerAttachExtensionError.unavailable
+            }
+            let descriptor = try IdentityLinkProtocolService.descriptor(for: human)
+            var rows: [PolicyRow] = []
+            for id in try await store.identifiers() {
+                guard let data = try await store.read(id: id) else { continue }
+                let record = try OwnerAttachWire.decode(OwnerAttachExtensionClientRecord.self, data: data)
+                guard let policy = record.policy,
+                      OwnerAttachWire.sameKey(policy.binding.requester, descriptor) else { continue }
+                rows.append(PolicyRow(binding: policy.binding,
+                    label: record.receipt?.consent.offer.receiverLabel ?? policy.binding.receiver.displayName ?? "Tidligere sted",
+                    policy: policy))
+            }
+            policies = rows.sorted { $0.label < $1.label }
+            policyLoadError = nil
+        } catch {
+            policies = []
+            policyLoadError = "Policyene kunne ikke åpnes med den aktive identiteten."
+        }
+    }
+
+    func forgetPolicy(_ binding: OwnerAttachExtensionBinding) async {
+        do {
+            guard let client else { throw OwnerAttachExtensionError.unavailable }
+            try await client.forgetPolicy(for: binding)
+            await refreshPolicies()
+        } catch { policyLoadError = "Innstillingen kunne ikke lagres." }
+    }
+
+    func dismissStatus() { status = nil }
+}
+
+struct BindingOwnerAttachReviewView: View {
+    let review: BindingOwnerAttachExtension.Review
+    @ObservedObject private var controller = BindingOwnerAttachExtension.shared
+    var body: some View {
+        VStack(alignment: .leading, spacing: 18) {
+            Text("Bruke entiteten din også her?").font(.title2.bold())
+            Text(review.offer.receiverLabel).font(.headline)
+            Text(review.endpoint).font(.caption).textSelection(.enabled)
+            Text("Du har bevist at identiteten din eier cellen. HAVEN kan huske at du bruker entiteten din på dette stedet. Identiteten og domenet beholdes.")
+            Text("Dette registrerer tilstedeværelse. Dataflytting, indeksering og varsler velges separat.")
+                .font(.callout).foregroundStyle(.secondary)
+            Text("Domene: \(review.offer.binding.domain)").font(.caption)
+            Button("Denne gangen") { controller.resolve(.once) }
+                .buttonStyle(.borderedProminent).accessibilityIdentifier("ownerAttach.once")
+            Button("Automatisk her i ett år") { controller.resolve(.alwaysHere) }
+                .accessibilityIdentifier("ownerAttach.always")
+            Button("Ikke spør på dette stedet i ett år") { controller.resolve(.neverHere) }
+            Button("Ikke nå", role: .cancel) { controller.resolve(nil) }
+                .accessibilityIdentifier("ownerAttach.cancel")
+        }
+        .padding(24)
+        .frame(idealWidth: 480)
+        .onDisappear { controller.resolve(nil, reviewID: review.id) }
+    }
+}
+
+struct BindingOwnerAttachPolicyView: View {
+    @ObservedObject private var controller = BindingOwnerAttachExtension.shared
+    var body: some View {
+        VStack(alignment: .leading, spacing: 16) {
+            Text("Utvidelse ved cellebruk").font(.title2.bold())
+            Text("HAVEN spør før entiteten tas i bruk på et nytt sted. Lagrede valg gjelder bare den samme mottakernøkkelen, identiteten og domenet, i inntil ett år.")
+            if let error = controller.policyLoadError { Text(error).foregroundStyle(.red) }
+            if controller.policies.isEmpty && controller.policyLoadError == nil {
+                Text("Ingen lagrede automatiske valg.").foregroundStyle(.secondary)
+            }
+            ForEach(controller.policies) { row in
+                VStack(alignment: .leading, spacing: 8) {
+                    Text(row.label).font(.headline)
+                    Text(row.binding.domain).font(.caption)
+                    Text(row.policy.choice == .neverHere ? "Ikke spør" : "Automatisk")
+                    Text("Utløper \(row.policy.expiresAt.formatted(date: .abbreviated, time: .omitted))").font(.caption)
+                    Button("Spør neste gang") { Task { await controller.forgetPolicy(row.binding) } }
+                }
+                Divider()
+            }
+            Spacer()
+        }
+        .padding(20)
+        .task { await controller.refreshPolicies() }
+    }
+}
