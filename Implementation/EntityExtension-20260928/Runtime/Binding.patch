@@ -12,6 +12,21 @@ import CellBase
 final class IdentityLinkFlowTests: XCTestCase {
     private let origin = "https://staging.haven.digipomps.org"
 
+    @MainActor
+    func testPolicyEntryPointOnlyOpensSettingsAndRejectsExtraPayload() {
+        let presenter = IdentityLinkFlowPresenter.shared
+        presenter.isPresented = false
