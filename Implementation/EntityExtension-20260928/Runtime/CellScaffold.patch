+++ b/private/tmp/haven-owner-attach-runtime/CellScaffold/Sources/App/Support/OwnerAttachRuntimeSupport.swift
@@ -0,0 +1,39 @@
+import Foundation
+import CellBase
+import Vapor
+
+/// Uses the already provisioned runtime signer; never mints a new service
+/// identity during strict production startup.
+enum OwnerAttachRuntimeSupport {
+    static func configure(app: Application, receiver: Identity) async {
+        guard let secrets = CellBase.defaultIdentityVault as? any ScopedSecretProviderProtocol,
+              let root = CellBase.documentRootPath else {
+            await OwnerAttachExtensionRuntime.shared.install(nil)
+            return
+        }
+        do {
+            let key = try await secrets.scopedSecretData(tag: "cellscaffold.owner-attach-presence.v1", minimumLength: 32)
+            let store = try OwnerAttachEncryptedStore(
+                directory: URL(fileURLWithPath: root).appendingPathComponent("OwnerAttachReceipts"), key: key)
+            let host = OwnerAttachEntityExtensionHost(receiver: receiver, label: "HAVEN på \(CellBase.hostname)", store: store)
+            await OwnerAttachExtensionRuntime.shared.install(host)
+        } catch {
+            await OwnerAttachExtensionRuntime.shared.install(nil)
+            app.logger.warning("Owner-attach entity presence unavailable; ordinary Cell access remains available.")
+        }
+    }
+
+    struct Readiness: Content {
+        let schema = "haven.owner-attach-readiness.v1"
+        let available: Bool
+    }
+
+    static func registerHealthRoute(app: Application) {
+        app.get("health", "entity-presence") { request async throws -> Response in
+            let available = await OwnerAttachExtensionRuntime.shared.host != nil
+            let response = try await Readiness(available: available).encodeResponse(for: request)
+            response.status = available ? .ok : .serviceUnavailable
+            return response
+        }
+    }
+}
diff --git a/private/tmp/haven-owner-attach-runtime/CellScaffold/Tests/AppTests/OwnerAttachRuntimeSupportTests.swift b/private/tmp/haven-owner-attach-runtime/CellScaffold/Tests/AppTests/OwnerAttachRuntimeSupportTests.swift
new file mode 100644
index 00000000..df2aac3b
--- /dev/null
+++ b/private/tmp/haven-owner-attach-runtime/CellScaffold/Tests/AppTests/OwnerAttachRuntimeSupportTests.swift
@@ -0,0 +1,50 @@
+import CellBase
+import Vapor
+import XCTVapor
+import XCTest
+@testable import App
+
+final class OwnerAttachRuntimeSupportTests: XCTestCase {
+    actor Store: OwnerAttachExtensionStore {
+        var rows: [String: Data] = [:]
+        func read(id: String) -> Data? { rows[id] }
+        func write(_ data: Data, id: String) { rows[id] = data }
+    }
+
+    func testReadinessReportsActualInstallationWithoutIdentityData() async throws {
+        let app = try await Application.make(.testing)
+        let previous = await OwnerAttachExtensionRuntime.shared.host
+        OwnerAttachRuntimeSupport.registerHealthRoute(app: app)
+        do {
+            await OwnerAttachExtensionRuntime.shared.install(nil)
+            try await app.test(.GET, "/health/entity-presence") { response async throws in
+                XCTAssertEqual(response.status, .serviceUnavailable)
+                let fields = try response.content.decode([String: ValueType].self)
+                XCTAssertEqual(Set(fields.keys), ["schema", "available"])
+                XCTAssertEqual(fields["available"], .bool(false))
+            }
+            let vault = EphemeralIdentityVault()
+            let storedSigner = await vault.identity(for: "receipt-test", makeNewIfNotFound: true)
+            let signer = try XCTUnwrap(storedSigner)
+            await OwnerAttachExtensionRuntime.shared.install(OwnerAttachEntityExtensionHost(
+                receiver: signer, label: "Synthetic receiver", store: Store()))
+            try await app.test(.GET, "/health/entity-presence") { response async throws in
+                XCTAssertEqual(response.status, .ok)
+                let fields = try response.content.decode([String: ValueType].self)
+                XCTAssertEqual(Set(fields.keys), ["schema", "available"])
+                XCTAssertEqual(fields["available"], .bool(true))
+                XCTAssertEqual(fields["schema"], .string("haven.owner-attach-readiness.v1"))
+            }
+            XCTAssertTrue(ProductionRuntimeAdmissionMiddleware.isAllowedHealthRequest(
+                method: .GET, path: "/health/entity-presence"))
+            XCTAssertFalse(ProductionRuntimeAdmissionMiddleware.isAllowedHealthRequest(
+                method: .POST, path: "/health/entity-presence"))
+            await OwnerAttachExtensionRuntime.shared.install(previous)
+            try await app.asyncShutdown()
+        } catch {
+            await OwnerAttachExtensionRuntime.shared.install(previous)
+            try? await app.asyncShutdown()
+            throw error
+        }
+    }
+}
